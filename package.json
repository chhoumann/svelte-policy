{
  "name": "svelte-policy",
  "version": "0.0.0",
  "description": "Svelte component policies checked on the compiler's AST, with an oxlint plugin that shares one config.",
  "keywords": [
    "lint",
    "oxlint",
    "svelte"
  ],
  "homepage": "https://github.com/chhoumann/svelte-policy#readme",
  "bugs": {
    "url": "https://github.com/chhoumann/svelte-policy/issues"
  },
  "license": "MIT",
  "author": "Christian B. B. Houmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhoumann/svelte-policy.git"
  },
  "bin": {
    "svelte-policy": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "default": "./dist/oxlint.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "changeset": "changeset",
    "dev": "vp pack --watch",
    "release": "changeset publish",
    "release:check": "vp check && vp test && vp pack",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version",
    "prepublishOnly": "vp pack"
  },
  "dependencies": {
    "esquery": "^1.7.0",
    "zimmerframe": "^1.1.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.6.4",
    "oxlint": "1.87.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3",
    "vite-plus": "^1.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    }
  }
}
